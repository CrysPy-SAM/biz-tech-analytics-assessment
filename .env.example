# Django Configuration
DEBUG=True
SECRET_KEY=django-insecure-assessment-biz-tech-analytics-secret-key-prod-change-me
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL in Docker / SQLite fallback locally)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/biztech_db
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis & Celery Configuration (Used in Section 2)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Silk Profiler
SILK_PROFILER_ENABLED=True

